# RCB SIGNAL — konfiguracja (wszystkie wartości opcjonalne)
# Skopiuj do .env. Podstawowe demo NIE wymaga żadnych sekretów ani internetu.

# Adres i port serwera demonstracyjnego
HOST=127.0.0.1
PORT=8080

# Dostawca opinii doradczej dla SIGNAL WRITER:
#   mock      — tylko deterministyczny silnik regułowy (domyślnie, zalecane na prezentację)
#   anthropic — dodatkowo opinia doradcza modelu Claude (wymaga: pip install anthropic + klucz API)
# Wynik jakości (78 → 92) ZAWSZE liczy silnik regułowy — LLM go nie zmienia.
SIGNAL_PROVIDER=mock
SIGNAL_MODEL=claude-opus-5-5

# Wymagane tylko przy SIGNAL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
